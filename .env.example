# EmailJS credentials for the /contact form (https://www.emailjs.com).
# Copy this file to `.env.local` (already gitignored) and fill in the values.
# All three are public by design: EmailJS public keys ship in the browser
# bundle. Limit abuse in the EmailJS dashboard (allowed domains, rate limits),
# not by hiding these.
#
# Without them, `npm start` simulates a successful send (and logs the payload
# to the console); a production build shows the form's error state instead.

# Email Services > your connected service > Service ID
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
# Email Templates > your template > Template ID
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
# Account > General > Public Key
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxx
